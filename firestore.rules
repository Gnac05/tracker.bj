rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un administrateur est un compte dont l'UID possède un document
    // dans la collection « admins » (créé à la main dans la console).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ----- Notes des usagers -----
    // Chaque lieu porte un agrégat (ratingSum, ratingCount). Un usager ne
    // peut le modifier que dans la même transaction que SON avis, et
    // seulement du montant exact de sa note : impossible de gonfler ou de
    // faire baisser la moyenne autrement.
    function reviewPath(placeId) {
      return /databases/$(database)/documents/reviews/$(placeId + '_' + request.auth.uid);
    }

    function ratingDeltaOk(placeId) {
      let oldSum = resource.data.get('ratingSum', 0);
      let oldCount = resource.data.get('ratingCount', 0);
      let newRating = getAfter(reviewPath(placeId)).data.rating;
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingSum', 'ratingCount'])
        && (exists(reviewPath(placeId))
            ? (request.resource.data.ratingCount == oldCount
               && request.resource.data.ratingSum
                    == oldSum + newRating - get(reviewPath(placeId)).data.rating)
            : (request.resource.data.ratingCount == oldCount + 1
               && request.resource.data.ratingSum == oldSum + newRating));
    }

    // Lecture publique ; écriture réservée aux administrateurs, sauf la
    // mise à jour de la note agrégée décrite ci-dessus.
    match /stations/{stationId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || ratingDeltaOk(stationId);
    }

    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || ratingDeltaOk(pharmacyId);
    }

    // Avis : lecture publique, un seul avis par usager et par lieu
    // (identifiant « <lieu>_<uid> »), modifiable par son auteur,
    // supprimable par un administrateur (modération).
    function placePath(data) {
      return /databases/$(database)/documents/$(data.placeType == 'pharmacy' ? 'pharmacies' : 'stations')/$(data.placeId);
    }

    function reviewValid(reviewId) {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['placeId', 'placeType', 'userId', 'authorName',
                             'rating', 'comment', 'updatedAt'])
        && d.userId == request.auth.uid
        && reviewId == d.placeId + '_' + request.auth.uid
        && d.placeType in ['station', 'pharmacy']
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() <= 400
        && d.authorName is string && d.authorName.size() <= 30
        && d.updatedAt == request.time
        && exists(placePath(d));
    }

    // L'agrégat du lieu doit évoluer dans la même transaction, du bon montant.
    function aggregateFollows(oldRating, isNew) {
      let before = get(placePath(request.resource.data)).data;
      let after = getAfter(placePath(request.resource.data)).data;
      return after.ratingSum
               == before.get('ratingSum', 0) + request.resource.data.rating - oldRating
        && after.ratingCount == before.get('ratingCount', 0) + (isNew ? 1 : 0);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if reviewValid(reviewId) && aggregateFollows(0, true);
      allow update: if reviewValid(reviewId)
        && resource.data.placeId == request.resource.data.placeId
        && resource.data.placeType == request.resource.data.placeType
        && aggregateFollows(resource.data.rating, false);
      allow delete: if isAdmin();
    }

    // Signalements : tout utilisateur (connexion anonyme) peut en créer un,
    // toujours « en attente ». Seul un administrateur peut les lire,
    // les certifier ou les rejeter.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'stationId', 'stationName', 'hasFuel', 'userId', 'photoUrl',
             'distanceMeters', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.hasFuel is bool
        && request.resource.data.photoUrl is string
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/stations/$(request.resource.data.stationId));
      allow read, update, delete: if isAdmin();
    }

    // Chacun peut seulement vérifier son propre rôle ; aucune écriture
    // depuis l'application.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
